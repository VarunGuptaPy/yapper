<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ counterpart to allowBackup="false": exclude everything from
     both cloud backup and device-to-device transfer. Yap's data stays on the
     phone unless you export it yourself. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
